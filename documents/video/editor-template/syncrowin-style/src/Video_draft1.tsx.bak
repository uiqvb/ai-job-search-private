// Syncrowin intro video (phase 2). All times below are ROUGH-CUT seconds (words.json);
// out() shifts anything after the toss by the length of the inserted chase cutaway.
import React from "react";
import {
  AbsoluteFill, Audio, Img, OffthreadVideo, Sequence, interpolate, random, spring,
  staticFile, useCurrentFrame, Easing,
} from "remotion";
import { loadFont as loadMont } from "@remotion/google-fonts/Montserrat";
import { loadFont as loadMarker } from "@remotion/google-fonts/PermanentMarker";
import { loadFont as loadMono } from "@remotion/google-fonts/JetBrainsMono";
import palm from "./palm_track.json";

const { fontFamily: MONT } = loadMont("normal", { weights: ["600", "700", "800", "900"] });
const { fontFamily: MARKER } = loadMarker();
const { fontFamily: MONO } = loadMono("normal", { weights: ["400", "700"] });

// Syncrowin palette (syncrowin.com.au CSS)
const LIME = "#9BF03C";
const BLACK = "#0C0C0C";
const INK = "#111110";
const OFF = "#F4F4EF";
const GREY1 = "#CDCDC5";
const GREY2 = "#75756E";

export const FPS = 30;
const TRACK_LEN = 59.333;
const INS = 15.75; // rough-cut second where the chase cutaway is inserted (hand frozen at shoulder)
const GAP = 2.4; // cutaway length
export const TOTAL_FRAMES = Math.ceil((TRACK_LEN + GAP) * FPS);
const CAPTIONS = false; // built later, once graphics are signed off

const out = (t: number) => (t < INS ? t : t + GAP);
const F = (t: number) => Math.round(out(t) * FPS);
const INS_F = Math.round(INS * FPS);
const GAP_F = Math.round(GAP * FPS);

const clamp = { extrapolateLeft: "clamp", extrapolateRight: "clamp" } as const;
const lerp = (t: number, a: number[], b: number[], ease?: (x: number) => number) =>
  interpolate(t, a, b, { ...clamp, easing: ease });
const popIn = (frame: number, atOut: number, damping = 9) =>
  spring({ frame: frame - atOut * FPS, fps: FPS, config: { damping, stiffness: 190, mass: 0.6 } });

// ---------- key moments (rough-cut seconds) ----------
const W = {
  minute: 1.26, hundred: 3.42, project: 5.54, fiveK: 10.46, six: 12.40, tossStart: 15.2,
  youre: 17.04, curious: 18.66, energy: 19.82, experiments: 20.84, exactlyMe: 22.02, iCant: 23.12,
  whatIf: 23.92, breaks: 27.40, fun: 28.78, inASmall: 29.32,
  backend: 35.54, hardware: 36.88, it: 38.04, video: 39.88,
  because: 40.54, revealEnd: 44.9, ignite: 47.6, imagine: 50.64, syncrowin: 51.74, fist: 52.35,
  name: 53.22, watching: 56.72, endCard: 57.15,
};

// ---------- palm tracking (rough-cut seconds -> pixel offset) ----------
type Row = number[];
const trackAt = (rows: Row[], t: number) => {
  if (t <= rows[0][0]) return [rows[0][1], rows[0][2]];
  for (let i = 1; i < rows.length; i++) {
    if (t <= rows[i][0]) {
      const a = rows[i - 1], b = rows[i];
      const k = (t - a[0]) / (b[0] - a[0]);
      return [a[1] + (b[1] - a[1]) * k, a[2] + (b[2] - a[2]) * k];
    }
  }
  const l = rows[rows.length - 1];
  return [l[1], l[2]];
};
// reference points measured on full-res frames: reel palm surface (180,1600) at 4.0 s,
// fire palm (165,1455) at 49.0 s
const reelPalm = (t: number) => {
  const [x, y] = trackAt(palm.reel as Row[], t);
  return [180 + (x - 280), 1600 + (y - 1632)];
};
const firePalm = (t: number) => {
  const [x, y] = trackAt(palm.fire as Row[], t);
  return [165 + (x - 288), 1455 + (y - 1588)];
};

// ======================================================================
// Props that sit on the palm
// ======================================================================
const Badge100: React.FC<{ glow?: number }> = ({ glow = 1 }) => (
  <div style={{
    width: 250, padding: "18px 0 14px", borderRadius: 26, background: BLACK, border: `6px solid ${LIME}`,
    boxShadow: `0 0 ${40 * glow}px ${LIME}AA, 0 10px 30px rgba(0,0,0,0.45)`, textAlign: "center",
    fontFamily: MONT, color: LIME,
  }}>
    <div style={{ fontSize: 76, fontWeight: 900, lineHeight: 1 }}>100<span style={{ fontSize: 40 }}>/100</span></div>
    <div style={{ fontSize: 24, fontWeight: 800, color: OFF, letterSpacing: 3, marginTop: 6 }}>BACKEND</div>
  </div>
);

const RobotProp: React.FC<{ t: number }> = ({ t }) => (
  <div style={{ width: 250, textAlign: "center", transform: `translateY(${Math.sin(t * 7) * 8}px) rotate(${Math.sin(t * 5) * 7}deg)` }}>
    <Img src={staticFile("img/robot_sticker.png")} style={{ width: 250, filter: "drop-shadow(0 10px 18px rgba(0,0,0,0.45))" }} />
    <div style={{
      display: "inline-block", marginTop: -6, padding: "6px 16px", borderRadius: 12, background: LIME, color: BLACK,
      fontFamily: MONT, fontWeight: 900, fontSize: 24, letterSpacing: 2,
    }}>OPEN DAY</div>
  </div>
);

const Badge6x: React.FC<{ stamp: number }> = ({ stamp }) => (
  <div style={{
    width: 250, padding: "14px 0 12px", borderRadius: 26, background: LIME, color: BLACK, textAlign: "center",
    fontFamily: MONT, boxShadow: "0 10px 30px rgba(0,0,0,0.45)",
  }}>
    <div style={{ fontSize: 30, fontWeight: 900, letterSpacing: 1 }}>{stamp > 0.05 ? "5,000 ROBOTS" : "SIMULATED"}</div>
    <div style={{ position: "relative", height: 92 }}>
      <div style={{ position: "absolute", width: "100%", fontSize: 80, fontWeight: 900, lineHeight: 1.1, opacity: 1 - Math.min(1, stamp * 3) }}>5,000</div>
      <div style={{
        position: "absolute", width: "100%", fontSize: 92, fontWeight: 900, lineHeight: 1, opacity: Math.min(1, stamp * 2),
        transform: `scale(${2 - stamp}) rotate(${(1 - stamp) * -20}deg)`,
      }}>6x<span style={{ fontSize: 34 }}> FASTER</span></div>
    </div>
  </div>
);

// Stack slots above the palm: bottom, middle, top (centre offsets from the palm surface)
const SLOTS = [[30, -130], [30, -370], [30, -600]];

const PalmProps: React.FC<{ frame: number }> = ({ frame }) => {
  const t = frame / FPS; // output seconds (only used before the cutaway, so = rough-cut time)
  if (t < W.hundred - 0.1 || t >= INS) return null;
  const [px, py] = reelPalm(t);
  // toss: hand swings back to the shoulder 15.2 -> 15.5; props fly over the shoulder, staggered
  const items = [
    { at: W.hundred, el: <Badge100 glow={0.7 + 0.3 * Math.sin(t * 6)} /> },
    { at: W.project, el: <RobotProp t={t} /> },
    { at: W.fiveK, el: <Badge6x stamp={popIn(frame, W.six, 8)} /> },
  ];
  return (
    <AbsoluteFill>
      {items.map((it, i) => {
        if (t < it.at - 0.05) return null;
        const s = popIn(frame, it.at);
        const tossK = lerp(t, [W.tossStart + i * 0.04, W.tossStart + 0.38 + i * 0.04], [0, 1], Easing.in(Easing.quad));
        const [sx, sy] = SLOTS[i];
        const bx = px + sx, by = py + sy;
        // arc up and back past his right shoulder (frame left), shrinking as it goes behind him
        const x = bx + tossK * (-60 - i * 40) + Math.sin(tossK * Math.PI) * -80;
        const y = by + tossK * (-900 - i * 120);
        const sc = s * (1 - 0.65 * tossK);
        const rot = tossK * (-200 - i * 90);
        return (
          <div key={i} style={{
            position: "absolute", left: x, top: y, transform: `translate(-50%,-50%) scale(${sc}) rotate(${rot}deg)`,
            opacity: 1 - lerp(tossK, [0.75, 1], [0, 1]),
          }}>{it.el}</div>
        );
      })}
    </AbsoluteFill>
  );
};

